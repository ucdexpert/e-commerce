{
  "version": 2,
  "name": "eshop-frontend",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "http://localhost:8000/api"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
