# Database (NeonDB) - Replace with your actual NeonDB connection string
DATABASE_URL=your_neondb_connection_string_here
# JWT Secret Key - Change in production!
SECRET_KEY=your_secret_key_here

# Stripe API Keys (Optional - for payments)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# JazzCash Payment Gateway (Optional - for Pakistan)
JAZZCASH_ENVIRONMENT=sandbox  # sandbox or live
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id
JAZZCASH_PASSWORD=your_jazzcash_password
JAZZCASH_INTEGRITY_SALT=your_jazzcash_integrity_salt
JAZZCASH_CUSTOMER_CNIC_LAST6=123456
JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/
JAZZCASH_LIVE_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API/
JAZZCASH_CALLBACK_URL=https://your-domain.com/api/jazzcash/callback

# EasyPaisa Payment Gateway (Optional - for Pakistan)
EASYPaisA_ENVIRONMENT=sandbox  # sandbox or live
EASYPaisA_STORE_ID=your_easypaisa_store_id
EASYPaisA_API_USERNAME=your_easypaisa_api_username
EASYPaisA_API_PASSWORD=your_easypaisa_api_password
EASYPaisA_SECRET_KEY=your_easypaisa_secret_key
EASYPaisA_SANDBOX_URL=https://sandbox.easypaisa.com.pk/merchantservices/
EASYPaisA_LIVE_URL=https://easypaisa.com.pk/merchantservices/
EASYPaisA_CALLBACK_URL=https://your-domain.com/api/easypaisa/callback

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=e-comarce
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT algorithm
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# STRIPE PAYMENTS (Optional)
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys


# SMTP Configuration (for sending emails)
# Note: On Hugging Face free tier, SMTP is blocked. Use SendGrid API instead.
SENDGRID_API_KEY=your_sendgrid_api_key_hereSENDGRID_FROM_EMAIL=hassankhilji26@gmail.com

# -----------------------------------------------------------------------------
# APP SETTINGS
# -----------------------------------------------------------------------------
APP_NAME=E-Commerce API
DEBUG=True
API_VERSION=1.0.0

# -----------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# -----------------------------------------------------------------------------
# REDIS (Optional - for caching/sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=3
